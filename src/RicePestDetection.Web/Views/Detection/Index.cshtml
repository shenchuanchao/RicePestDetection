@{
    ViewData["Title"] = "图像检测";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">水稻病虫害图像检测</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <strong>使用说明：</strong>请上传水稻叶片或植株的清晰图片，系统将自动识别病虫害类型并给出防治建议。支持 JPG、PNG、BMP 格式，文件大小不超过 10MB。
                </div>

                <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-4">
                        <div class="border-2 border-dashed rounded p-5 text-center" id="dropZone" style="border-color: #2e7d32; background-color: #f1f8e9;">
                            <div class="mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="#2e7d32" viewBox="0 0 16 16">
                                    <path d="M8 4a.5.5 0 0 1 .5.5v6.793l2.146-2.147a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L7.5 11.293V4.5A.5.5 0 0 1 8 4z"/>
                                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                                </svg>
                            </div>
                            <p class="mb-2">点击或拖拽图片到此处上传</p>
                            <input type="file" name="image" id="imageInput" accept=".jpg,.jpeg,.png,.bmp" class="d-none" />
                            <button type="button" class="btn btn-outline-success" onclick="document.getElementById('imageInput').click()">选择图片</button>
                        </div>
                        <div id="preview" class="mt-3 text-center d-none">
                            <img id="previewImg" src="" alt="预览" class="img-thumbnail" style="max-height: 250px;" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success btn-lg w-100" id="submitBtn" disabled>
                        <span class="spinner-border spinner-border-sm d-none" id="loadingSpinner"></span>
                        开始检测
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const imageInput = document.getElementById('imageInput');
        const preview = document.getElementById('preview');
        const previewImg = document.getElementById('previewImg');
        const submitBtn = document.getElementById('submitBtn');
        const dropZone = document.getElementById('dropZone');

        imageInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    preview.classList.remove('d-none');
                    submitBtn.disabled = false;
                };
                reader.readAsDataURL(file);
            }
        });

        dropZone.addEventListener('dragover', function(e) {
            e.preventDefault();
            dropZone.style.backgroundColor = '#c8e6c9';
        });

        dropZone.addEventListener('dragleave', function(e) {
            e.preventDefault();
            dropZone.style.backgroundColor = '#f1f8e9';
        });

        dropZone.addEventListener('drop', function(e) {
            e.preventDefault();
            dropZone.style.backgroundColor = '#f1f8e9';
            const file = e.dataTransfer.files[0];
            if (file && file.type.startsWith('image/')) {
                imageInput.files = e.dataTransfer.files;
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    preview.classList.remove('d-none');
                    submitBtn.disabled = false;
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('uploadForm').addEventListener('submit', function() {
            document.getElementById('loadingSpinner').classList.remove('d-none');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '检测中，请稍候...';
        });
    </script>
}
